# Porta em que a API vai rodar
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Origens permitidas pelo CORS, separadas por vírgula (sem "/" no final)
# formato: "http://localhost:5173,https://meuapp.vercel.app"
ALLOWED_ORIGINS=http://localhost:5173

# String de conexão do Postgres (ver Backend/docker-compose.yml)
DATABASE_URL=postgres://erick:123456@localhost:5433/ledger_louis

# String de conexão do Redis (ver Backend/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Driver de armazenamento de arquivos: local | cloudinary
STORAGE_DRIVER=local

# Necessário somente se STORAGE_DRIVER=cloudinary
# Preencha com as credenciais da sua conta em https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rotação automática das chaves JWT (true | false)
ENABLE_KEY_ROTATION=true
