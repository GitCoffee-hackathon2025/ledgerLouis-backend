      }

      .header {
        background: #2563eb;
        color: #ffffff;
        padding: 24px 32px;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
      }

      .content {
        padding: 32px;
        line-height: 1.6;
      }

      .footer {
        padding: 24px 32px;
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        font-size: 13px;
        color: #6b7280;
      }

      a {
        color: #2563eb;
      }
